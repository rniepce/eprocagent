# ── PostgreSQL (pgvector) ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=eproc_dev_2026
POSTGRES_DB=eproc_rag

# ── Azure OpenAI ────────────────────────────────────────────────
AZURE_API_KEY=
AZURE_ENDPOINT=https://assistente-web-resource.cognitiveservices.azure.com/
AZURE_API_VERSION=2024-12-01-preview
AZURE_LLM_MODEL=gpt-5.5
AZURE_EMBEDDING_MODEL=text-embedding-3-large-2
AZURE_EMBEDDING_DIMENSIONS=3072

# ── Segurança ───────────────────────────────────────────────────
# Chave para proteger endpoints de upload/admin
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
UPLOAD_API_KEY=

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Rate limiting (requisições por minuto por IP)
RATE_LIMIT=30/minute

# Tamanho máximo de upload em MB
MAX_UPLOAD_SIZE_MB=50
